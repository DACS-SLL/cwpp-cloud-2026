<group name="uts,portal,">
  <rule id="100100" level="7">
    <decoded_as>json</decoded_as>
    <field name="@source">^uts-portal$</field>
    <field name="event">^login_failed$</field>
    <description>UTS: intento de ingreso fallido al portal académico.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100101" level="6">
    <decoded_as>json</decoded_as>
    <field name="@source">^uts-portal$</field>
    <field name="event">^access_denied$</field>
    <description>UTS: acceso denegado a una función académica.</description>
    <group>access_denied,</group>
  </rule>

  <rule id="100102" level="10">
    <decoded_as>json</decoded_as>
    <field name="@source">^uts-portal$</field>
    <field name="event">^service_unavailable$</field>
    <description>UTS: servicio de datos no disponible para el portal.</description>
    <group>service_availability,</group>
  </rule>

  <rule id="100103" level="5">
    <decoded_as>json</decoded_as>
    <field name="@source">^uts-portal$</field>
    <field name="event">^database_query_failed$</field>
    <description>UTS: fallo en una consulta académica.</description>
    <group>database,</group>
  </rule>
</group>
